/* 鬼骰 · 暗桌金线
 * 暗底 + 铜金强调色：骰子桌的质感，不用微信那种蓝白商务风。
 * 只用 rpx，一屏竖着放得下牌桌（iPhone SE 到 Pro Max 都不折行）。
 */
page {
  --bg: #0f0d0a;
  --bg2: #17130f;
  --card: #1c1712;
  --card2: #221b15;
  --line: #322a22;
  --txt: #efe6da;
  --dim: #9a8f83;
  --gold: #e0b878;
  --gold2: #f2d49b;
  --ok: #6fbf8f;
  --bad: #e0736b;
  --zhai: #a98bd6;

  background: var(--bg);
  color: var(--txt);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page { padding: 24rpx 24rpx 40rpx; box-sizing: border-box; }

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card.flat { background: var(--bg2); }

.h1 { font-size: 44rpx; font-weight: 600; letter-spacing: 4rpx; color: var(--gold2); }
.h2 { font-size: 32rpx; font-weight: 600; color: var(--txt); }
.lab { font-size: 24rpx; color: var(--dim); letter-spacing: 1rpx; }
.hint { font-size: 24rpx; color: var(--dim); line-height: 1.7; }
.gold { color: var(--gold); }
.bad { color: var(--bad); }
.ok { color: var(--ok); }

.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.mt { margin-top: 16rpx; }
.mt8 { margin-top: 8rpx; }

.field { margin-bottom: 20rpx; }
.field .lab { display: block; margin-bottom: 10rpx; }
.input {
  height: 84rpx;
  background: var(--bg2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 20rpx;
  color: var(--txt);
  font-size: 28rpx;
}
.textarea {
  width: 100%;
  height: 180rpx;
  background: var(--bg2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  color: var(--txt);
  font-size: 26rpx;
  box-sizing: border-box;
}

.btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--card2);
  border: 1rpx solid var(--line);
  color: var(--txt);
  font-size: 28rpx;
}
.btn.primary {
  background: linear-gradient(180deg, #efc98a, #c99a55);
  color: #2a1d0c;
  border-color: #d8ac6c;
  font-weight: 600;
}
.btn.ghost { background: transparent; color: var(--dim); }
.btn.danger { color: var(--bad); border-color: #4a2a26; }
.btn.sm { height: 60rpx; line-height: 60rpx; font-size: 24rpx; padding: 0 22rpx; }
.btn[disabled] { opacity: .38; }

.chip {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--card2);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--dim);
}
.chip.on { color: #2a1d0c; background: var(--gold); border-color: var(--gold); }
.chip.live { color: var(--ok); border-color: #2e4a3a; }
.chip.dead { color: var(--bad); border-color: #4a2a26; }
.chip.zhai { color: var(--zhai); border-color: #3d3150; }

.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }

/* 骰子：九宫格点位，1-6 用固定的点阵，与网页版同一套画法 */
.dice { display: flex; gap: 14rpx; flex-wrap: wrap; }
.die {
  width: 96rpx; height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #fbf6ec, #ddd0bb);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  padding: 10rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 14rpx rgba(0,0,0,.45), inset 0 1rpx 0 #fff;
}
.die .dot { display: block; border-radius: 50%; }
.die .dot.on { background: #2a2118; box-shadow: inset 0 -1rpx 2rpx rgba(0,0,0,.5); }
.die .dot.wild-on { background: #b8452f; }
.die.back {
  background: repeating-linear-gradient(45deg, #2a231c, #2a231c 8rpx, #241d17 8rpx, #241d17 16rpx);
  border: 1rpx solid #3a3026;
  box-shadow: none;
}
.die.back .dot { background: transparent; }

.empty { padding: 30rpx 0; text-align: center; color: var(--dim); font-size: 26rpx; }

/* 选择器：个数 / 模式这类横向选项，多个页面共用 */
.chips { white-space: nowrap; margin-top: 10rpx; }
.chipbtn {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: var(--bg2);
  border: 1rpx solid var(--line);
  color: var(--txt);
  font-size: 28rpx;
}
.chipbtn.on { background: var(--gold); color: #2a1d0c; border-color: var(--gold2); font-weight: 600; }

.acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.acts .btn { flex: 1; }
